{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "teslamarket",
	"main": "./workers/app.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "teslamarket-db",
			"database_id": "a0c0ea2d-4e45-42a5-bc89-64c8968ea4b4",
			"migrations_dir": "db/migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "R2",
			"bucket_name": "teslamarket-photos"
		}
	]
}
